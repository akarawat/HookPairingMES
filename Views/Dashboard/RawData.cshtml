@{
    ViewData["Title"] = "Data Explorer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="filter-bar mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label-mes">Part Type</label>
                <select id="rdPartType" class="form-control form-control-mes">
                    <option value="Body">Hook Body</option>
                    <option value="Guideway">Hook Guideway</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label-mes">Date From</label>
                <input type="date" id="rdDateFrom" class="form-control form-control-mes"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label-mes">Date To</label>
                <input type="date" id="rdDateTo" class="form-control form-control-mes"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label-mes">WO No.</label>
                <input type="text" id="rdWoNo" class="form-control form-control-mes" placeholder="All" />
            </div>
            <div class="col-md-2">
                <label class="form-label-mes">Serial No.</label>
                <input type="text" id="rdMacSn" class="form-control form-control-mes" placeholder="All" />
            </div>
            <div class="col-md-1">
                <button id="rdSearch" class="btn btn-refresh w-100">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
            <div class="col-md-1">
                <button id="rdExport" class="btn btn-export w-100">
                    <i class="bi bi-file-earmark-excel"></i> Export
                </button>
            </div>
        </div>
    </div>

    <div class="chart-panel">
        <div class="chart-panel-header">
            <span class="chart-title"><i class="bi bi-table me-1"></i> Measurement Records</span>
            <span id="rdTotalInfo" class="text-secondary small"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-mes" id="rdTable">
                <thead>
                    <tr>
                        <th>ID</th><th>Part</th><th>Serial No.</th>
                        <th>WO No.</th><th>Box</th><th>OPR</th>
                        <th>A1 (μm)</th><th>A2 (μm)</th>
                        <th>Z1 (μm)</th><th>X1 (μm)</th>
                        <th>Measured At</th>
                    </tr>
                </thead>
                <tbody id="rdTableBody">
                    <tr><td colspan="11" class="text-center text-secondary">Click Search to load data</td></tr>
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-2 px-2">
            <div class="small text-secondary" id="rdPageInfo">–</div>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="rdPagination"></ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/rawdata.js" asp-append-version="true"></script>
}
