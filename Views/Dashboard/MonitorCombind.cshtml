@model HookPairingMES.Models.Dashboard.MonitorCombindViewModel
@{
    ViewData["Title"] = "Monitor Combined";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* ══ PAGE HEADER ══════════════════════════════════════════════════════════════ *@
<div class="mc-header">
    <div>
        <h4>🔗 Hook Pairing — Monitor Combined</h4>
        <small class="text-white-50">Real-time measurement dashboard</small>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span id="mcHubStatus" class="badge bg-secondary">Connecting…</span>
        <div class="mc-live-badge">
            <div class="mc-live-dot"></div>
            <span>LIVE</span>
        </div>
        <small id="mcLastUpdated">—</small>
    </div>
</div>

@* ══ SECTION 1 — HOOK BODY (A1 / A2 / Z1 / X1) ══════════════════════════════ *@
<div class="mc-section-label">⚙ Hook Body — Measurement Channels</div>
<div class="row g-3 mb-4">
    @foreach (var ch in new[] { ("A1","ch-a1"), ("A2","ch-a2"), ("Z1","ch-z1"), ("X1","ch-x1") })
    {
        <div class="col-6 col-md-3">
            <div class="card channel-card @ch.Item2" id="card-@ch.Item1">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@ch.Item1 <small class="fw-normal opacity-75">μm</small></span>
                </div>
                <div class="card-body">
                    <div class="channel-val" id="val-@ch.Item1">—.—————</div>
                    <div class="channel-sub mt-2">SN: <span id="sn-@ch.Item1">—</span></div>
                    <div class="channel-sub">WO: <span id="wo-@ch.Item1">—</span></div>
                    <div class="channel-sub" id="time-@ch.Item1" style="color:#aaa">—</div>
                </div>
            </div>
        </div>
    }
</div>

@* ══ SECTION 2 — FEATURE_2 TABLES ════════════════════════════════════════════ *@
<div class="mc-section-label">📐 Feature_2 — Measurement Log (Latest 5)</div>
<div class="row g-3 mb-4">

    @* Table 1 : Feature_2_Measurement *@
    <div class="col-12 col-xl-6">
        <div class="card f2-card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span>📊 Feature_2_Measurement</span>
                <span class="badge bg-white text-primary" id="badge-t1">@Model.MeasTable1.Count rows</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table f2-table">
                        <thead>
                            <tr>
                                <th>#</th><th>Value (F2)</th><th>Item No</th>
                                <th>Class</th><th>Received At</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-f2-1">
                            @foreach (var r in Model.MeasTable1)
                            {
                                <tr>
                                    <td class="text-muted">@r.MesId</td>
                                    <td class="f2-val text-primary">@r.OpwValue.ToString("F5")</td>
                                    <td class="f2-itemno" title="@r.ItemNo">
                                        @if (r.ItemNo != null) { @r.ItemNo } else { <span class="text-muted">—</span> }
                                    </td>
                                    <td><span class="badge bg-@r.ClassBadge">@r.ClassLabel</span></td>
                                    <td class="f2-time">@r.ReceivedAt.ToString("dd/MM HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* Table 2 : Feature_2_Measurement_2 *@
    <div class="col-12 col-xl-6">
        <div class="card f2-card">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span>📊 Feature_2_Measurement_2</span>
                <span class="badge bg-white text-success" id="badge-t2">@Model.MeasTable2.Count rows</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table f2-table">
                        <thead>
                            <tr>
                                <th>#</th><th>Value (F2)</th><th>Item No</th>
                                <th>Class</th><th>Received At</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-f2-2">
                            @foreach (var r in Model.MeasTable2)
                            {
                                <tr>
                                    <td class="text-muted">@r.MesId</td>
                                    <td class="f2-val text-success">@r.OpwValue.ToString("F5")</td>
                                    <td class="f2-itemno" title="@r.ItemNo">
                                        @if (r.ItemNo != null) { @r.ItemNo } else { <span class="text-muted">—</span> }
                                    </td>
                                    <td><span class="badge bg-@r.ClassBadge">@r.ClassLabel</span></td>
                                    <td class="f2-time">@r.ReceivedAt.ToString("dd/MM HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* ══ SECTION 3 — MEASUREMENT LOG ════════════════════════════════════════════ *@
<div class="mc-section-label">📋 Measurement Log</div>
<div class="card" style="border:none; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,.08);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0" id="mcLogTable"
                   style="font-size:.82rem; font-family:'Share Tech Mono','Courier New',monospace;">
                <thead style="font-size:.7rem; font-weight:700; text-transform:uppercase; color:#6c757d;">
                    <tr>
                        <th style="width:55px; padding:8px 10px;">#</th>
                        <th style="width:80px;">Part</th>
                        <th>Serial No.</th>
                        <th>WO No.</th>
                        <th>Box</th>
                        <th>OPR</th>
                        <th class="text-end">A1</th>
                        <th class="text-end">A2</th>
                        <th class="text-end">Z1</th>
                        <th class="text-end">X1</th>
                        <th style="width:90px;">Time</th>
                    </tr>
                </thead>
                <tbody id="mcLogBody">
                    <tr>
                        <td colspan="11" class="text-center py-4 text-secondary">
                            <i class="bi bi-hourglass-split me-2"></i>กำลังโหลด…
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ══ ส่งค่า initial จาก Razor → JS ผ่าน window.MC ════════════════════════════ *@
<script>
    window.MC = {
        lastId1: @(Model.MeasTable1.FirstOrDefault()?.MesId ?? 0),
        lastId2: @(Model.MeasTable2.FirstOrDefault()?.MesId ?? 0)
    };
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/monitorCombind.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/monitorCombind.js" asp-append-version="true"></script>
}
